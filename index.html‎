    let currentQuiz = [];
    let currentIndex = 0;
    let userAnswers = {};
    let timer = null;
    let timeLeft = 1800; // 30 phút = 1800 giây
    let wrongQuestions = JSON.parse(localStorage.getItem('wrong_llđ_100') || '[]');

    document.getElementById('wrong-count').innerText = wrongQuestions.length;

    function toggleTheme() {
        const body = document.body;
        body.getAttribute('data-theme') === 'dark' ? body.setAttribute('data-theme', 'light') : body.setAttribute('data-theme', 'dark');
    }

    function startQuiz() {
        // Lấy ngẫu nhiên 20 câu từ ngân hàng 100 câu
        currentQuiz = [...questionBank].sort(() => 0.5 - Math.random()).slice(0, 20);
        currentIndex = 0;
        userAnswers = {};
        
        document.getElementById('home-screen').classList.remove('active');
        document.getElementById('quiz-screen').classList.add('active');
        
        startTimer();
        renderQuestion();
    }

    function startTimer() {
        timeLeft = 1800;
        clearInterval(timer);
        timer = setInterval(() => {
            timeLeft--;
            let mins = Math.floor(timeLeft / 60);
            let secs = timeLeft % 60;
            document.getElementById('timer-display').innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
            if (timeLeft <= 0) {
                clearInterval(timer);
                submitQuiz();
            }
        }, 1000);
    }

    function renderQuestion() {
        const q = currentQuiz[currentIndex];
        document.getElementById('progress-text').innerText = `Câu ${currentIndex + 1}/${currentQuiz.length} (${q.chapter})`;
        
        let html = `<div class="question-box"><h3>${q.q}</h3><div class="options">`;
        q.options.forEach((opt, idx) => {
            let checked = userAnswers[currentIndex] === idx ? 'checked' : '';
            html += `<label><input type="radio" name="question" value="${idx}" ${checked} onclick="saveAnswer(${currentIndex}, ${idx})"> ${opt}</label>`;
        });
        html += `</div></div>`;
        
        document.getElementById('question-container').innerHTML = html;
        
        document.getElementById('prev-btn').style.display = currentIndex === 0 ? 'none' : 'inline-block';
        if (currentIndex === currentQuiz.length - 1) {
            document.getElementById('next-btn').style.display = 'none';
            document.getElementById('submit-btn').style.display = 'inline-block';
        } else {
            document.getElementById('next-btn').style.display = 'inline-block';
            document.getElementById('submit-btn').style.display = 'none';
        }
    }

    function saveAnswer(qIdx, optIdx) {
        userAnswers[qIdx] = optIdx;
    }

    function nextQuestion() {
        if (currentIndex < currentQuiz.length - 1) { currentIndex++; renderQuestion(); }
    }

    function prevQuestion() {
        if (currentIndex > 0) { currentIndex--; renderQuestion(); }
    }

    function submitQuiz() {
        clearInterval(timer);
        document.getElementById('quiz-screen').classList.remove('active');
        document.getElementById('result-screen').classList.add('active');

        let score = 0;
        let reviewHtml = '';

        currentQuiz.forEach((q, idx) => {
            let userAns = userAnswers[idx];
            let isCorrect = userAns === q.answer;
            if (isCorrect) score++;
            else {
                if (!wrongQuestions.some(item => item.q === q.q)) {
                    wrongQuestions.push(q);
                }
            }

            reviewHtml += `<div class="result-item ${isCorrect ? 'correct' : 'wrong'}">
                <strong>Câu ${idx + 1} (${q.chapter}): ${q.q}</strong><br>
                Đáp án của bạn: <b>${userAns !== undefined ? q.options[userAns] : 'Chưa chọn'}</b><br>
                Đáp án đúng: <b>${q.options[q.answer]}</b>
                <div class="explanation">💡 <b>Giải thích:</b> ${q.exp}</div>
            </div>`;
        });

        localStorage.setItem('wrong_llđ_100', JSON.stringify(wrongQuestions));
        document.getElementById('wrong-count').innerText = wrongQuestions.length;
        document.getElementById('score-summary').innerText = `Kết quả của bạn: ${score} / ${currentQuiz.length} câu đúng`;
        document.getElementById('review-container').innerHTML = reviewHtml;
    }

    function viewWrongQuestions() {
        if (wrongQuestions.length === 0) {
            alert('Hiện tại danh sách câu sai đang trống! Hãy làm bài thi thử để hệ thống ghi nhận nhé.');
            return;
        }
        currentQuiz = [...wrongQuestions];
        currentIndex = 0;
        userAnswers = {};
        document.getElementById('home-screen').classList.remove('active');
        document.getElementById('quiz-screen').classList.add('active');
        document.getElementById('timer-display').innerText = "Ôn tập lỗi";
        renderQuestion();
    }

    function goHome() {
        document.getElementById('result-screen').classList.remove('active');
        document.getElementById('home-screen').classList.add('active');
    }
</script>
