        { q: "Khi người lao động đơn phương chấm dứt hợp đồng xác định thời hạn (12-36 tháng), phải báo trước ít nhất bao nhiêu ngày?", options: ["30 ngày", "45 ngày", "3 ngày làm việc", "10 ngày"], answer: 0, chapter: "Chương 5", exp: "Hợp đồng từ 12 đến 36 tháng phải báo trước ít nhất 30 ngày." },
        { q: "Trường hợp hợp đồng lao động dưới 12 tháng, khi người lao động muốn đơn phương chấm dứt thì phải báo trước ít nhất bao nhiêu ngày làm việc?", options: ["Ít nhất 3 ngày làm việc", "30 ngày", "Không cần báo trước", "15 ngày"], answer: 0, chapter: "Chương 5", exp: "Hợp đồng dưới 12 tháng phải báo trước ít nhất 3 ngày làm việc." },
        { q: "Người lao động được quyền đơn phương chấm dứt hợp đồng không cần báo trước trong trường hợp nào sau đây?", options: ["Không được trả đủ lương hoặc trả lương không đúng hạn", "Thích nghỉ thì nghỉ", "Doanh nghiệp chuyển địa điểm", "Công ty tăng ca"], answer: 0, chapter: "Chương 5", exp: "Điểm b khoản 2 Điều 35 quy định NLĐ nghỉ không cần báo trước nếu không được trả đủ lương." },
        { q: "Người sử dụng lao động không được quyền đơn phương chấm dứt hợp đồng lao động với người lao động trong trường hợp nào?", options: ["Người lao động đang ốm đau hoặc tai nạn đang điều trị theo quyết định của bác sĩ", "Người lao động đi muộn", "Không hoàn thành công việc", "Doanh nghiệp thu hẹp sản xuất"], answer: 0, chapter: "Chương 5", exp: "Căn cứ Điều 37, NSDLĐ không được đơn phương chấm dứt hợp đồng khi NLĐ ốm đau, tai nạn." },
        { q: "Mức trợ cấp thôi việc cứ mỗi năm làm việc được tính bằng mấy tháng tiền lương?", options: ["0,5 tháng tiền lương", "1 tháng tiền lương", "2 tháng tiền lương", "3 tháng tiền lương"], answer: 0, chapter: "Chương 5", exp: "Căn cứ Điều 46, trợ cấp thôi việc bằng 0,5 tháng tiền lương cho mỗi năm làm việc." },
        { q: "Thời gian thử việc tối đa đối với công việc bình thường là bao nhiêu ngày?", options: ["30 ngày", "60 ngày", "6 ngày", "10 ngày"], answer: 0, chapter: "Chương 5", exp: "Công việc bình thường thời gian thử việc tối đa là 30 ngày (Điều 25)." },
        { q: "Thỏa ước lao động tập thể phải được thông qua tại Đại hội lao động với tỷ lệ biểu quyết tán thành tối thiểu là bao nhiêu?", options: ["Trên 50% số người tham gia", "100% tuyệt đối", "Đúng 30%", "Trên 80%"], answer: 0, chapter: "Chương 6", exp: "Căn cứ Điều 77, TƯLĐTT phải được trên 50% số người tham gia biểu quyết tán thành." },
        { q: "Thời hạn tối đa của thỏa ước lao động tập thể là bao lâu?", options: ["Từ 1 năm đến 3 năm", "5 năm", "6 tháng", "Không giới hạn"], answer: 0, chapter: "Chương 6", exp: "Căn cứ Điều 79, thời hạn của TƯLĐTT là từ 01 năm đến 03 năm." },
        { q: "Đối thoại tại nơi làm việc định kỳ phải được tổ chức ít nhất bao lâu một lần?", options: ["Ít nhất 1 năm một lần", "1 tháng một lần", "3 năm một lần", "Không bắt buộc"], answer: 0, chapter: "Chương 6", exp: "Đối thoại định kỳ tại nơi làm việc ít nhất 01 năm một lần theo Nghị định hướng dẫn." },
        { q: "Chủ thể nào tiến hành thương lượng tập thể tại cấp doanh nghiệp?", options: ["Đại diện người sử dụng lao động và tổ chức đại diện người lao động tại cơ sở", "Chỉ cơ quan nhà nước", "Tòa án lao động", "Liên đoàn lao động tỉnh"], answer: 0, chapter: "Chương 6", exp: "Thương lượng tập thể diễn ra giữa NSDLĐ và tổ chức đại diện NLĐ tại cơ sở." },
        { q: "Thỏa ước lao động tập thể sau khi ký kết phải được gửi cho cơ quan nào?", options: ["Cơ quan chuyên môn về lao động thuộc Ủy ban nhân dân cấp tỉnh", "Bộ Công an", "Tòa án", "Cục thuế"], answer: 0, chapter: "Chương 6", exp: "Căn cứ Điều 81, gửi cho cơ quan chuyên môn về lao động cấp tỉnh trong 10 ngày." },
        { q: "Thời giờ làm việc bình thường theo Bộ luật Lao động 2019 không quá bao nhiêu giờ trong một ngày?", options: ["Không quá 8 giờ trong 1 ngày", "Không quá 10 giờ trong 1 ngày", "Không quá 12 giờ trong 1 ngày", "Không quá 6 giờ trong 1 ngày"], answer: 0, chapter: "Chương 7", exp: "Căn cứ Điều 105, thời giờ làm việc bình thường không quá 8 giờ/ngày và 48 giờ/tuần." },
        { q: "Tổng số giờ làm thêm của người lao động trong một năm (trường hợp bình thường) tối đa là bao nhiêu?", options: ["200 giờ", "100 giờ", "300 giờ", "500 giờ"], answer: 0, chapter: "Chương 7", exp: "Căn cứ điểm b khoản 2 Điều 107, số giờ làm thêm tối đa trong năm là 200 giờ." },
