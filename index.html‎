        { q: "Thời hiệu xử lý kỷ luật lao động tối đa là bao nhiêu tháng kể từ ngày xảy ra hành vi vi phạm?", options: ["Tối đa 6 tháng (trường hợp tài chính, tài sản là 12 tháng)", "3 tháng", "12 tháng cho mọi trường hợp", "24 tháng"], answer: 0, chapter: "Kỷ luật", exp: "Căn cứ khoản 1 Điều 123, thời hiệu xử lý kỷ luật là 6 tháng (12 tháng với tài chính/tài sản)." },
        { q: "Tranh chấp lao động cá nhân bao gồm tranh chấp giữa ai với ai?", options: ["Giữa người lao động với người sử dụng lao động", "Giữa công đoàn với nhà nước", "Giữa doanh nghiệp với tòa án", "Giữa các doanh nghiệp"], answer: 0, chapter: "Tranh chấp", exp: "Tranh chấp lao động cá nhân diễn ra giữa NLĐ và NSDLĐ." },
