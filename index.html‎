<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ôn Thi Luật Lao Động 2019 - 100 Câu</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-color: #f8fafc;
            --text-muted: #94a3b8;
            --primary-color: #8b5cf6;
            --primary-hover: #7c3aed;
            --border-color: #334155;
            --option-bg: #0f172a;
            --option-hover: #1e293b;
            --correct-bg: rgba(16, 185, 129, 0.15);
            --correct-border: #10b981;
            --correct-text: #34d399;
            --wrong-bg: rgba(239, 68, 68, 0.15);
            --wrong-border: #ef4444;
            --wrong-text: #f87171;
        }
        [data-theme="light"] {
            --bg-color: #f1f5f9;
            --card-bg: #ffffff;
            --text-color: #1e293b;
            --text-muted: #64748b;
            --primary-color: #6366f1;
            --primary-hover: #4f46e5;
            --border-color: #e2e8f0;
            --option-bg: #f8fafc;
            --option-hover: #f1f5f9;
            --correct-bg: #d1fae5;
            --correct-border: #10b981;
            --correct-text: #065f46;
            --wrong-bg: #fee2e2;
            --wrong-border: #ef4444;
            --wrong-text: #991b1b;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 12px;
            transition: background 0.3s, color 0.3s;
        }
        .app-container {
            width: 100%;
            max-width: 650px;
            background: var(--card-bg);
            border-radius: 20px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
            padding: 24px;
            border: 1px solid var(--border-color);
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 16px;
            margin-bottom: 20px;
        }
        h1 { font-size: 17px; font-weight: 700; color: var(--text-color); }
        .theme-toggle {
            background: var(--option-bg);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 6px 12px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
        }
        .screen { display: none; }
        .screen.active { display: block; }
        
        .hero-title { font-size: 22px; font-weight: 800; margin-bottom: 10px; color: var(--primary-color); }
        .hero-desc { color: var(--text-muted); font-size: 14px; line-height: 1.5; margin-bottom: 20px; }
        ul.features-list { list-style: none; margin-bottom: 24px; }
        ul.features-list li { font-size: 14px; color: var(--text-color); margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
        
        .quiz-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
        }
        .timer {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            padding: 4px 10px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 14px;
        }
        .question-box h3 {
            font-size: 16px;
            font-weight: 700;
            line-height: 1.5;
            margin-bottom: 16px;
        }
        .options label {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            margin: 10px 0;
            background-color: var(--option-bg);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
        }
        .options label:hover { background-color: var(--option-hover); border-color: var(--primary-color); }
        .options input { margin-right: 12px; accent-color: var(--primary-color); transform: scale(1.2); }
        
        .btn-group { display: flex; gap: 10px; margin-top: 24px; }
        button.main-btn {
            flex: 1;
            background-color: var(--primary-color);
            color: #ffffff;
            border: none;
            padding: 12px 20px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            transition: background 0.2s;
        }
        button.main-btn:hover { background-color: var(--primary-hover); }
        button.sec-btn {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 12px 16px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
        }
        
        .result-item {
            padding: 14px;
            margin-bottom: 12px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            font-size: 13px;
            line-height: 1.4;
        }
        .result-item.correct { background-color: var(--correct-bg); border-color: var(--correct-border); color: var(--correct-text); }
        .result-item.wrong { background-color: var(--wrong-bg); border-color: var(--wrong-border); color: var(--wrong-text); }
        .explanation { margin-top: 6px; font-style: italic; opacity: 0.9; }
        
        #review-container { max-height: 60vh; overflow-y: auto; padding-right: 4px; }
    </style>
</head>
<body>
<div class="app-container">
    <header>
        <h1>Luật Lao Động 2019 (100 Câu)</h1>
        <button class="theme-toggle" onclick="toggleTheme()">🌓 Giao diện</button>
    </header>

    <div id="home-screen" class="screen active">
        <div class="hero-title">Ôn Thi Trắc Nghiệm 🚀</div>
        <div class="hero-desc">Kho 100 câu hỏi bám sát 7 chương đề cương, trộn ngẫu nhiên 20 câu mỗi lượt thi.</div>
        <ul class="features-list">
            <li>⚡ Đề ngẫu nhiên: 20 câu / 30 phút</li>
            <li>💡 Giải thích chi tiết theo Luật Lao động 2019</li>
            <li>📌 Tự động lưu câu làm sai để ôn tập lại</li>
        </ul>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <button class="main-btn" onclick="startQuiz()">Bắt đầu thi thử ngay</button>
            <button class="sec-btn" onclick="viewWrongQuestions()" style="color: #ef4444; border-color: #ef4444;">Xem lại câu hay sai (<span id="wrong-count">0</span>)</button>
        </div>
    </div>

    <div id="quiz-screen" class="screen">
        <div class="quiz-header">
            <span id="progress-text">Câu 1/20</span>
            <div class="timer" id="timer-display">30:00</div>
        </div>
        <div id="question-container"></div>
        <div class="btn-group">
            <button class="sec-btn" id="prev-btn" onclick="prevQuestion()" style="display:none;">Quay lại</button>
            <button class="main-btn" id="next-btn" onclick="nextQuestion()">Câu tiếp theo</button>
            <button class="main-btn" id="submit-btn" onclick="submitQuiz()" style="background-color: #10b981; display:none;">Nộp bài</button>
        </div>
    </div>

    <div id="result-screen" class="screen">
        <div class="hero-title" style="font-size: 18px;">Kết Quả Ôn Tập</div>
        <p id="score-summary" style="font-size: 15px; font-weight: 700; margin: 10px 0 16px 0; color: var(--primary-color);"></p>
        <div id="review-container"></div>
        <div style="margin-top: 16px;">
            <button class="main-btn" onclick="goHome()">Về trang chủ</button>
        </div>
    </div>
</div>

<script>
    const questionBank = [
        { q: "Quan hệ lao động bắt buộc phải có yếu tố cốt lõi nào sau đây?", options: ["Sự bình đẳng tuyệt đối về tài sản", "Sự lệ thuộc pháp lý giữa người lao động và người sử dụng lao động", "Tính chất thương mại vụ lợi thuần túy", "Sự chuyển dịch quyền sở hữu tư liệu sản xuất"], answer: 1, chapter: "Chương 1", exp: "Theo lý luận Luật Lao động, quan hệ lao động có tính chất lệ thuộc pháp lý." },
        { q: "Theo Bộ luật Lao động 2019, người lao động là người từ đủ bao nhiêu tuổi trở lên?", options: ["Đủ 13 tuổi", "Đủ 15 tuổi", "Đủ 18 tuổi", "Đủ 16 tuổi"], answer: 1, chapter: "Chương 2", exp: "Căn cứ Điều 2 Bộ luật Lao động 2019, người lao động là người từ đủ 15 tuổi trở lên." },
        { q: "Chủ thể nào sau đây không phải là người sử dụng lao động theo BLLĐ 2019?", options: ["Doanh nghiệp", "Cơ quan, tổ chức", "Hợp tác xã", "Hộ gia đình không có thuê mướn lao động"], answer: 3, chapter: "Chương 2", exp: "Hộ gia đình phải có thuê mướn lao động mới là NSDLĐ." },
        { q: "Nguyên tắc cơ bản nào của Luật Lao động bảo vệ quyền lợi về việc làm?", options: ["Quyền làm việc, tự do lựa chọn việc làm", "Phải làm việc suốt đời cho một cơ quan", "Cấm người lao động nhảy việc", "Nhà nước ấn định mọi công việc"], answer: 0, chapter: "Chương 1", exp: "Điều 4 quy định quyền làm việc và tự do lựa chọn việc làm." },
        { q: "Đối tượng điều chỉnh của Luật Lao động Việt Nam là gì?", options: ["Toàn bộ quan hệ xã hội phát sinh trong xã hội", "Quan hệ lao động thuê mướn và các quan hệ liên quan trực tiếp đến quan hệ lao động", "Chỉ quan hệ công chức nhà nước", "Quan hệ hợp đồng dịch vụ dân sự"], answer: 1, chapter: "Chương 1", exp: "Luật Lao động điều chỉnh quan hệ lao động thuê mướn và các quan hệ xã hội liên quan trực tiếp." },
        { q: "Phương pháp điều chỉnh đặc thù của Luật Lao động là gì?", options: ["Phương pháp mệnh lệnh tuyệt đối", "Phương pháp bình đẳng thỏa thuận kết hợp với sự tham gia của tổ chức đại diện và quyền quản lý điều hành", "Phương pháp tự định đoạt hoàn toàn", "Phương pháp xử phạt hành chính"], answer: 1, chapter: "Chương 1", exp: "Kết hợp giữa thỏa thuận và quyền quản lý, mệnh lệnh hợp pháp của NSDLĐ." },
        { q: "Nguồn của Luật Lao động Việt Nam bao gồm văn bản nào có hiệu lực pháp lý cao nhất?", options: ["Bộ luật Lao động", "Hiến pháp", "Nghị định của Chính phủ", "Thông tư của Bộ LĐTBXH"], answer: 1, chapter: "Chương 1", exp: "Hiến pháp là đạo luật gốc có hiệu lực cao nhất." },
        { q: "Quan hệ pháp luật nào sau đây là quan hệ có liên quan trực tiếp đến quan hệ lao động?", options: ["Quan hệ học nghề, tập nghề", "Quan hệ mua bán nhà ở", "Quan hệ thừa kế tài sản", "Quan hệ tố tụng dân sự"], answer: 0, chapter: "Chương 2", exp: "Quan hệ học nghề, tập nghề là tiền đề của quan hệ lao động." },
        { q: "Người sử dụng lao động là cá nhân khi giao kết hợp đồng lao động phải có năng lực gì?", options: ["Năng lực hành vi dân sự đầy đủ", "Đủ 15 tuổi trở lên", "Được cấp bằng đại học", "Không bị phá sản"], answer: 0, chapter: "Chương 2", exp: "Cá nhân là NSDLĐ phải có năng lực hành vi dân sự đầy đủ." },
        { q: "Lịch sử phát triển Luật Lao động Việt Nam gắn liền với mốc ra đời của sắc lệnh nào trong thời kỳ kháng chiến?", options: ["Các sắc lệnh về lao động của Chủ tịch Hồ Chí Minh (1945-1946)", "Bộ luật dân sự đầu tiên", "Luật đất đai", "Luật doanh nghiệp"], answer: 0, chapter: "Chương 1", exp: "Chủ tịch Hồ Chí Minh đã ký nhiều sắc lệnh bảo vệ quyền lợi NLĐ ngay sau 1945." },
        { q: "Tổ chức đại diện người lao động tại cơ sở bao gồm những tổ chức nào?", options: ["Chỉ có Công đoàn cơ sở", "Công đoàn cơ sở và Tổ chức của người lao động tại doanh nghiệp", "Hội chữ thập đỏ", "Đoàn thanh niên"], answer: 1, chapter: "Chương 3", exp: "Căn cứ Chương XII gồm Công đoàn cơ sở và tổ chức của NLĐ tại doanh nghiệp." },
        { q: "Tổ chức đại diện người sử dụng lao động trung ương tại Việt Nam nổi bật hiện nay là tổ chức nào?", options: ["Phòng Thương mại và Công nghiệp Việt Nam (VCCI)", "Tổng Liên đoàn Lao động", "Hội sinh viên", "Mặt trận Tổ quốc"], answer: 0, chapter: "Chương 3", exp: "VCCI là tổ chức đại diện quốc gia của người sử dụng lao động." },
        { q: "Quyền nào sau đây thuộc về tổ chức đại diện người lao động tại cơ sở?", options: ["Đại diện cho người lao động thương lượng tập thể", "Tự ý ra quyết định sa thải giám đốc", "Đóng cửa doanh nghiệp", "Phân phối lợi nhuận"], answer: 0, chapter: "Chương 3", exp: "Tổ chức đại diện NLĐ bảo vệ quyền lợi và thương lượng tập thể." },
        { q: "Thành lập tổ chức của người lao động tại doanh nghiệp phải tuân thủ điều kiện gì?", options: ["Được cơ quan nhà nước có thẩm quyền đăng ký", "Không cần đăng ký", "Phải được Thủ tướng phê duyệt", "Phải có 1000 thành viên"], answer: 0, chapter: "Chương 3", exp: "Phải được cơ quan nhà nước đăng ký theo quy định pháp luật." },
        { q: "Hình thức thương lượng giữa đại diện các bên trong quan hệ lao động không bao gồm hình thức nào?", options: ["Thương lượng tập thể", "Đối thoại tại nơi làm việc", "Đình công đơn phương không cần thương lượng", "Giải quyết tranh chấp lao động"], answer: 2, chapter: "Chương 3", exp: "Đình công không phải là hình thức thương lượng." },
        { q: "Doanh nghiệp hoạt động cho thuê lại lao động bắt buộc phải có điều kiện gì?", options: ["Phải được cấp Giấy phép hoạt động cho thuê lại lao động và ký quỹ", "Không cần điều kiện gì", "Chỉ cần đăng ký kinh doanh tạp hóa", "Phải là doanh nghiệp 100% vốn nhà nước"], answer: 0, chapter: "Chương 4", exp: "Căn cứ Điều 54, cho thuê lại lao động là ngành nghề kinh doanh có điều kiện (Giấy phép và ký quỹ 2 tỷ)." },
        { q: "Thời hạn tối đa cho thuê lại lao động đối với một người lao động là bao lâu?", options: ["12 tháng", "6 tháng", "24 tháng", "Không giới hạn"], answer: 0, chapter: "Chương 4", exp: "Thời hạn tối đa cho thuê lại là 12 tháng đối với mỗi người lao động." },
        { q: "Hành vi nào bị nghiêm cấm trong hoạt động cho thuê lại lao động?", options: ["Thu phí cho thuê lại lao động từ phía người lao động", "Ký hợp đồng bằng văn bản", "Báo cáo định kỳ", "Đóng bảo hiểm xã hội"], answer: 0, chapter: "Chương 4", exp: "Cấm thu tiền dịch vụ hoặc phí từ người lao động thuê lại." },
        { q: "Người lao động làm việc theo hình thức cho thuê lại có quyền hưởng tiền lương như thế nào?", options: ["Không được thấp hơn tiền lương của người lao động bên thuê lại", "Phải thấp hơn 50%", "Tùy ý doanh nghiệp", "Bằng mức tối thiểu chung"], answer: 0, chapter: "Chương 4", exp: "Lương không được thấp hơn người lao động của bên thuê lại có cùng trình độ." },
        { q: "Giải quyết việc làm thuộc trách nhiệm của ai theo pháp luật lao động?", options: ["Nhà nước, doanh nghiệp và toàn xã hội", "Chỉ cá nhân người lao động tự lo", "Chỉ có Bộ Lao động", "Công an nhân dân"], answer: 0, chapter: "Chương 4", exp: "Giải quyết việc làm là chính sách kinh tế - xã hội của Nhà nước và toàn xã hội." },
        { q: "Hợp đồng lao động có thời hạn từ đủ 1 tháng trở lên phải được giao kết theo hình thức nào?", options: ["Phải bằng văn bản", "Bằng lời nói", "Bằng tin nhắn SMS", "Bằng hành vi mặc nhiên"], answer: 0, chapter: "Chương 5", exp: "Căn cứ Điều 14, hợp đồng từ 1 tháng trở lên bắt buộc phải lập thành văn bản." },
        { q: "Thời gian thử việc tối đa đối với công việc có chức danh nghề nghiệp cần trình độ chuyên môn kỹ thuật từ cao đẳng trở lên là bao nhiêu ngày?", options: ["60 ngày", "30 ngày", "180 ngày", "15 ngày"], answer: 0, chapter: "Chương 5", exp: "Căn cứ Điều 25, thử việc tối đa 60 ngày đối với trình độ cao đẳng trở lên." },
        { q: "Tiền lương thử việc theo Điều 26 ít nhất phải bằng bao nhiêu phần trăm mức lương của công việc đó?", options: ["85%", "50%", "70%", "100%"], answer: 0, chapter: "Chương 5", exp: "Tiền lương thử việc ít nhất bằng 85% mức lương công việc." },
